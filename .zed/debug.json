[
  {
    "label": "Mamabloemetjes (Docker Debug)",
    "adapter": "Delve",
    "request": "launch",
    "mode": "debug",
    "program": "/app",
    "cwd": "/app",
    "buildFlags": "-buildvcs=false",
    "tcp_connection": {
      "host": "127.0.0.1",
      "port": 40000
    },
    "substitutePath": [
      {
        "from": "${ZED_WORKTREE_ROOT}/backend",
        "to": "/app"
      }
    ]
  }
]
